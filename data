def seed_demo_data():
    """Initializes rich demo roles, parsed candidates, match evaluations, and sample interviews."""
    # 1. Create Role
    role_id = "role-demo-distributed"
    jd_parsed = parse_job_description(SAMPLE_JD_DISTRIBUTED, title="Staff Distributed Systems Engineer", department="Core Infrastructure & Cloud Platforms", min_exp=6)
    
    role_obj = {
        "id": role_id,
        "title": jd_parsed["title"],
        "department": jd_parsed["department"],
        "min_experience_years": jd_parsed["min_experience_years"],
        "detected_skills": jd_parsed["detected_skills"],
        "requirements": jd_parsed["requirements"],
        "responsibilities": jd_parsed["responsibilities"],
        "raw_text": SAMPLE_JD_DISTRIBUTED,
        "created_at": datetime.datetime.now().isoformat()
    }
    upsert_role(role_obj)

    # 2. Seed Candidates
    candidates_raw = [
        ("elena-rostova", SAMPLE_RESUME_ELENA, "Elena_Rostova_Resume.pdf"),
        ("marcus-chen", SAMPLE_RESUME_MARCUS, "Marcus_Chen_Resume.docx"),
        ("aria-patel", SAMPLE_RESUME_ARIA, "Aria_Patel_Resume.pdf"),
        ("devon-vance", SAMPLE_RESUME_DEVON, "Devon_Vance_Resume.txt")
    ]

    for cand_slug, resume_text, filename in candidates_raw:
        cand_id = f"cand-{cand_slug}"
        parsed_cand = parse_resume(resume_text, filename=filename)
        parsed_cand["id"] = cand_id
        parsed_cand["role_id"] = role_id
        parsed_cand["filename"] = filename
        parsed_cand["uploaded_at"] = datetime.datetime.now().isoformat()

        # Run AI/NLP screening evaluation
        screening_res = process_candidate_screening(parsed_cand, role_obj)
        parsed_cand.update(screening_res)

        upsert_candidate(parsed_cand)
        record_audit("SCREENING_EVALUATION", cand_id, {
            "role_id": role_id,
            "match_score": screening_res["match_score"],
            "tier": screening_res["tier"],
            "citations_count": len(screening_res["requirements_mapping"])
        })

    # 3. Seed Interview Record for Elena
    elena_interview = {
        "candidate_id": "cand-elena-rostova",
        "role_id": role_id,
        "notes": SAMPLE_INTERVIEW_ELENA,
        "answers": {
            "q-1": "We tuned Kafka partition counts to match max consumer threads and used sticky partitioning to balance batch sizes without latency inflation."
        },
        "follow_ups": [
            {
                "question": "What happened when that service experienced unexpected latency or a network partition?",
                "rationale": "Validates resilience under production stress."
            }
        ],
        "updated_at": datetime.datetime.now().isoformat()
    }
    upsert_interview(elena_interview)

    return {
        "status": "success",
        "role_id": role_id,
        "candidates_seeded": len(candidates_raw)
    }
